# Normalizes formatter-owned text so all supported CI hosts inspect identical bytes.
.gitattributes text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
uv.lock text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
